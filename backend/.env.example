# Copy to .env and change every value. Never commit .env.
DATABASE_URL=postgresql+psycopg://acme:acme@localhost:5432/acme
SECRET_KEY=change-me-to-a-long-random-string
# Local development over plain http needs this off; keep it on in production (https).
SESSION_COOKIE_SECURE=false
DEMO_ADMIN_PASSWORD=change-me-admin
DEMO_VIEWER_PASSWORD=change-me-viewer
STORAGE_DIR=./storage
LOG_LEVEL=INFO
