# Copy to config.env (git-ignored; this example is committed). Nothing here is secret.
AWS_PROFILE=acme
AWS_REGION=ap-south-1
STACK_NAME=acme-salary
DOMAIN=acme.docrelay.in
# Budget alerts and Let's Encrypt certificate notices go here.
ALERT_EMAIL=you@example.com
BUDGET_USD=10
# The server backs up and stops itself this many hours after start/deploy (0 = never).
AUTO_STOP_HOURS=4
# Allowed to release with the GitHub Deploy button (leave empty for none). Not secret; get it with
# gh api repos/OWNER/REPO/actions/oidc/customization/sub --jq .sub_claim_prefix
GITHUB_OIDC_SUBJECT_PREFIX=repo:ujjawalkant09@48159084/acme-salary-management@1419158771
