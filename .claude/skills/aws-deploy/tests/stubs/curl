#!/usr/bin/env bash
# Fake curl for tests: records arguments and stdin (where headers arrive), prints STUB_CURL_OUT.
echo "curl $*" >>"$STUB_LOG"
if [[ "$*" == *"-H @-"* ]]; then
  cat >>"$STUB_STDIN_LOG"
fi
[[ "$*" == *"-X PUT"* ]] && touch "$STUB_LOG.dns_put"
# A new CNAME value, so the fake dig answers it from now on.
if [[ "$*" == *"-X PUT"*"/records/CNAME/"* ]]; then
  args=("$@")
  for ((i = 0; i < ${#args[@]}; i++)); do
    [[ "${args[i]}" == "--data" ]] && echo "${args[i + 1]}" >"$STUB_LOG.cname_put"
  done
fi
echo "${STUB_CURL_OUT:-[]}"
